<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        xmlns:validation="clr-namespace:View.ViewModel.Validation"
        Title="Contact" Height="400" Width="400" MinHeight="250" MinWidth="350"
        Icon="pack://application:,,,/Resources/ContactsApp_96x96.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="43"/>
        </Grid.RowDefinitions>

        <GroupBox Header ="Edit Contact" Grid.Row="0" Grid.Column="0" Margin="15,0,3,3">
            <StackPanel>
                <TextBlock Text="Name:" Margin="3,3,3,3"></TextBlock>
                <TextBox Height="20" Margin="3,3,3,3">
                    <TextBox.Text>
                        <Binding Path ="CurrentContact.Fullname" 
                         UpdateSourceTrigger="PropertyChanged" 
                         Mode="TwoWay">
                            <Binding.ValidationRules>
                                <validation:FullnameValidationRule/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Validation.HasError" Value="True">
                                    <Setter Property="BorderBrush" Value="Red"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Setter Property="Foreground" Value="Red" />
                                    <Setter Property="ToolTip"
                                Value="{Binding RelativeSource={RelativeSource Self},
                                    Path=(Validation.Errors)/ErrorContent}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <TextBlock Text="Phone Number:" Margin="3,3,3,3"></TextBlock>
                <TextBox Height="20" Margin="3,3,3,3">
                    <TextBox.Text>
                        <Binding Path="CurrentContact.PhoneNumber" 
                         UpdateSourceTrigger="PropertyChanged"
                         Mode="TwoWay">
                            <Binding.ValidationRules>
                                <validation:PhoneNumberValidationRule/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Validation.HasError" Value="True">
                                    <Setter Property="BorderBrush" Value="Red"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Setter Property="ToolTip"
                                 Value="{Binding RelativeSource={RelativeSource Self},
                                     Path=(Validation.Errors)/ErrorContent}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <TextBlock Text="Email:" Margin="3,3,3,3"></TextBlock>
                <TextBox Height="20" Margin="3,3,3,3">
                    <TextBox.Text>
                        <Binding Path="CurrentContact.Email"
                         UpdateSourceTrigger="PropertyChanged" 
                         Mode="TwoWay">
                            <Binding.ValidationRules>
                                <validation:EmailValidationRule/>
                            </Binding.ValidationRules>
                        </Binding>

                    </TextBox.Text>
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Validation.HasError" Value="True">
                                    <Setter Property="BorderBrush" Value="Red"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Setter Property="ToolTip"
                                 Value="{Binding RelativeSource={RelativeSource Self},
                                     Path=(Validation.Errors)/ErrorContent}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Read Contact" Grid.Row="0" Grid.Column="1" Margin="0,0,15,3">
            <StackPanel>
                <TextBlock Text="Name:" Margin="3,3,3,3"></TextBlock>
                <TextBox 
            Text="{Binding CurrentContact.Fullname, Mode=OneWay}"
            IsReadOnly="True"
            Height="20" FontWeight="Bold" BorderThickness="0" 
            Margin="3,3,3,3"></TextBox>

                <TextBlock Text="Phone Number:" Margin="3,3,3,3"></TextBlock>
                <TextBox 
            Text="{Binding CurrentContact.PhoneNumber, Mode=OneWay}"
            IsReadOnly="True"
            Height="20" FontWeight="Bold" BorderThickness="0"
            Margin="3,3,3,3"></TextBox>

                <TextBlock Text="Email:" Margin="3,3,3,3"></TextBlock>
                <TextBox 
            Text="{Binding CurrentContact.Email, Mode=OneWay}"
            IsReadOnly="True"
            Height="20" FontWeight="Bold" BorderThickness="0"
            Margin="3,3,3,3"></TextBox>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" 
                    HorizontalAlignment="Right" VerticalAlignment ="Bottom"
            Margin="0,3,15,15">
            <Button Content="Save" Command="{Binding SaveCommand}"
            Width="75" Height="25" Margin="0,0,3,0"/>
            <Button Content="Load" Command="{Binding LoadCommand}" Width="75" Height="25"/>
        </StackPanel>
    </Grid>
</Window>
