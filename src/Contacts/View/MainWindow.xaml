<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        xmlns:validation="clr-namespace:View.ViewModel.Validation"
        xmlns:viewModel="clr-namespace:View.ViewModel"
        xmlns:userControl="clr-namespace:View.UserControls"
        Title="Contact" Height="450" Width="700" MinHeight="350" MinWidth="550"
        Icon="pack://application:,,,/Resources/ContactsApp_96x96.ico">
    <Window.Resources>
        <viewModel:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="IsButtonsStyle" TargetType="Button">
            <Setter Property="Height" Value="25"/>
            <Setter Property="MinWidth" Value="75"/>
        </Style>

        <Style x:Key="IsApplyButton" TargetType="Button">
            <Setter Property="Visibility" Value="{Binding IsVisibleApply,
                Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Setter Property="Margin" Value="3,50,3,3"/>
            <Setter Property="Width" Value="75"/>
            <Setter Property="Height" Value="25"/>
        </Style>

        <DataTemplate x:Key="ContactTemplate">
            <StackPanel Margin="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Width="40" 
                       Height="40" 
                       Grid.Column="0"
                       Source="/Resources/photo_placeholder_100x100.png">
                        <Image.Clip>
                            <EllipseGeometry Center="20,20" 
                                             RadiusX="20" 
                                             RadiusY="20"/>
                        </Image.Clip>
                    </Image>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" 
                                   Margin="3,0,0,3"
                                   Text="{Binding Fullname}"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"/>

                        <TextBlock Grid.Row="1"
                                   Margin="3,0,0,3"
                                   Text="{Binding PhoneNumber}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"/>
                    </Grid>
                </Grid>
            </StackPanel>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" 
                Background="#f8f8f8">
        </Border>

        <Grid Grid.Column="0"
              Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="3" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                       Margin="3,0,3,0" 
                       Text="Find:" 
                       HorizontalAlignment="Left"/>

                <TextBox Grid.Column="1" 
                         x:Name="SearchBox" 
                         Margin="3,0,0,0" 
                         VerticalAlignment="Stretch"
                         HorizontalAlignment="Stretch"/>
            </Grid>

            <ListBox ItemsSource="{Binding Contacts}"
                     SelectedItem="{Binding SelectedContact}"
                     Grid.Row="1" 
                     Margin="3"
                     ItemTemplate="{StaticResource ContactTemplate}">
            </ListBox>

            <Grid Grid.Row="2"
                  Margin="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Content="Add" 
                        Command="{Binding AddContactCommand}"
                        Grid.Column="0"
                        Margin="0,0,3,0"
                        Style="{StaticResource IsButtonsStyle}"/>
                <Button Content="Edit" 
                        Command="{Binding EditContactCommand}"
                        Grid.Column="1"
                        Margin="3,0,3,0"
                        Style="{StaticResource IsButtonsStyle}"/>
                <Button Content="Remove" 
                        Command="{Binding RemoveContactCommand}"
                        Grid.Column="2" 
                        Margin="3,0,0,0"
                        Style="{StaticResource IsButtonsStyle}"/>
            </Grid>
        </Grid>

        <GridSplitter Grid.Column="1"
                      Width="3" 
                      Background="White" 
                      HorizontalAlignment="Stretch"/>

        <Border Grid.Column="2" 
                Background="White">
        </Border>

        <Grid Grid.Column="2" 
              Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <userControl:ContactControl x:Name="ContactControl"
                                        Grid.Row="0"/>
            <Button Grid.Row="1" 
                        Content="Apply" 
                        Command="{Binding ApplyContactCommand}"
                        Style="{StaticResource IsApplyButton}"
                        HorizontalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
