<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        xmlns:validation="clr-namespace:View.ViewModel.Validation"
        Title="Contact" Height="450" Width="700" MinHeight="250" MinWidth="350"
        Icon="pack://application:,,,/Resources/ContactsApp_96x96.ico">
    <Window.Resources>
        <Style x:Key="ValidationTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="3"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Foreground" Value="Red"/>
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self}, 
                        Path=(Validation.Errors)/ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReadTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="IsReadOnly" Value="true"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="EditGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,3,3"/>
        </Style>

        <Style x:Key="ReadGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="3,0,0,3"/>
        </Style>

        <Style x:Key="ButtonsStackPanelStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style x:Key="ButtonsStyle" TargetType="Button">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Width" Value="75"/>
        </Style>

    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="#f8f8f8"></StackPanel>
        <Grid Grid.Column="0"
              MinWidth="250" 
              Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="3" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                       Margin="3" 
                       Text="Find:" 
                       HorizontalAlignment="Left"/>

                <TextBox Grid.Column="1" 
                         x:Name="SearchBox" 
                         Margin="3,3,0,3" 
                         VerticalAlignment="Stretch"
                         HorizontalAlignment="Stretch"/>
            </Grid>

            <ListBox x:Name="ContactsList" 
                     Grid.Row="1" 
                     Grid.ColumnSpan="2" 
                     Margin="3"/>

            <Grid Grid.Row="2" Margin="3" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Content="Add" 
                        Grid.Column="0" 
                        Height="25" 
                        Margin="0,3,3,3" 
                        MinWidth="75"/>
                <Button Content="Edit" 
                        Grid.Column="1" 
                        Height="25" 
                        Margin="3" 
                        MinWidth="75"/>
                <Button Content="Remove" 
                        Grid.Column="2" 
                        Height="25" 
                        Margin="3,3,0,3" 
                        MinWidth="75"/>
            </Grid>
        </Grid>

        <GridSplitter Grid.Column="1"
                      Width="3" 
                      Background="White" 
                      HorizontalAlignment="Stretch"/>

        <StackPanel Grid.Column="2" 
                    Background="White">
        </StackPanel>

        <Grid Grid.Column="2" MinWidth="250" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Image Grid.Column="0"
                   Grid.Row="1"
                   Width="100"
                   Height="100" 
                   Margin="3" 
                   Grid.RowSpan="3" 
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Source="/Resources/photo_placeholder_100x100.png"/>

            <GroupBox BorderThickness="0" 
                      Grid.Row="0" 
                      Grid.Column="1">
                <TextBlock Text="Name:" 
                           Margin="3,3,3,0">
                </TextBlock>
            </GroupBox>

            <GroupBox BorderThickness="0" 
                  Grid.Row="1" 
                  Grid.Column="1">
                <StackPanel>
                    <TextBox Style="{StaticResource ReadTextBoxStyle}" Margin="3,0,3,3">
                        <TextBox.Text>
                            <Binding Path="CurrentContact.Fullname"
                                     UpdateSourceTrigger="PropertyChanged" 
                                     Mode="OneWay">
                            </Binding>
                        </TextBox.Text>
                    </TextBox>

                    <TextBlock Text="Phone Number:" Margin="3"></TextBlock>
                    <TextBox Style="{StaticResource ReadTextBoxStyle}">
                        <TextBox.Text>
                            <Binding Path="CurrentContact.PhoneNumber"
                                     UpdateSourceTrigger="PropertyChanged" 
                                     Mode="OneWay">
                            </Binding>
                        </TextBox.Text>
                    </TextBox>

                    <TextBlock Text="Email:" Margin="3"></TextBlock>
                    <TextBox Style="{StaticResource ReadTextBoxStyle}">
                        <TextBox.Text>
                            <Binding Path="CurrentContact.Email"
                                     UpdateSourceTrigger="PropertyChanged" 
                                     Mode="OneWay">
                            </Binding>
                        </TextBox.Text>
                    </TextBox>

                    <Button Content="Apply" 
                            Height="25" 
                            Width="75" 
                            Margin="3,50,3,3" 
                            HorizontalAlignment="Left"
                            Visibility="Hidden"/>
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
