<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        xmlns:validation="clr-namespace:View.ViewModel.Validation"
        xmlns:viewModel="clr-namespace:View.ViewModel"
        Title="Contact" Height="450" Width="700" MinHeight="250" MinWidth="350"
        Icon="pack://application:,,,/Resources/ContactsApp_96x96.ico">
    <Window.Resources>
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="IsReadOnly" Value="{Binding IsReadOnly}"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Foreground" Value="Red"/>
                    <Setter Property="ToolTip"
                Value="{Binding RelativeSource={RelativeSource Self}, 
            Path=(Validation.Errors)/ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <viewModel:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="IsEnabledButtons" TargetType="Button">
            <Setter Property="IsEnabled" Value="{Binding IsInEditingOrCreatingMode}"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="MinWidth" Value="75"/>
        </Style>

        <Style x:Key="IsApplyButton" TargetType="Button">
            <Setter Property="Visibility" Value="{Binding IsVisibleApply,
                Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Setter Property="Margin" Value="3,50,3,3"/>
            <Setter Property="Width" Value="75"/>
            <Setter Property="Height" Value="25"/>
        </Style>

    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" 
                Background="#f8f8f8">
        </Border>
        
        <Grid Grid.Column="0"
              Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" 
                  Margin="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                       Margin="3" 
                       Text="Find:" 
                       HorizontalAlignment="Left"/>

                <TextBox Grid.Column="1" 
                         x:Name="SearchBox" 
                         Margin="3,3,0,3" 
                         VerticalAlignment="Stretch"
                         HorizontalAlignment="Stretch"/>
            </Grid>

            <ListBox ItemsSource="{Binding Contacts}"
                     SelectedItem="{Binding SelectedContact}"
                     Grid.Row="1" 
                     Margin="3">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Path=Fullname}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="2" 
                  Margin="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Content="Add" 
                        Command="{Binding AddContactCommand}"
                        Grid.Column="0" 
                        Style="{StaticResource IsEnabledButtons}"/>
                <Button Content="Edit" 
                        Command="{Binding EditContactCommand}"
                        Grid.Column="1"
                        Style="{StaticResource IsEnabledButtons}"/>
                <Button Content="Remove" 
                        Command="{Binding RemoveContactCommand}"
                        Grid.Column="2" 
                        Style="{StaticResource IsEnabledButtons}"/>
            </Grid>
        </Grid>

        <GridSplitter Grid.Column="1"
                      Width="3" 
                      Background="White" 
                      HorizontalAlignment="Stretch"/>

        <Border Grid.Column="2" 
                Background="White">
        </Border>

        <Grid Grid.Column="2" 
              Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Image Grid.Column="0"
                   Grid.Row="1"
                   Width="100"
                   Height="100" 
                   Margin="3,0,3,3" 
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Source="/Resources/photo_placeholder_100x100.png"/>

            <TextBlock Text="Name:" 
                       Margin="3"
                       Grid.Row="0"
                       Grid.Column="1">
            </TextBlock>
            
            <Grid Grid.Column="1" 
                  Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0"
                    Style="{StaticResource TextBoxStyle}">
                    <TextBox.Text>
                        <Binding Path ="CurrentContact.Fullname" 
                                 UpdateSourceTrigger="PropertyChanged" 
                                 Mode="TwoWay">
                            <Binding.ValidationRules>
                                <validation:FullnameValidationRule/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>

                <TextBlock Grid.Row="1" 
                           Text="Phone Number:" 
                           Margin="3">
                </TextBlock>

                <TextBox Grid.Row="2"
                    Style="{StaticResource TextBoxStyle}">
                    <TextBox.Text>
                        <Binding Path ="CurrentContact.PhoneNumber" 
                                 UpdateSourceTrigger="PropertyChanged" 
                                 Mode="TwoWay">
                            <Binding.ValidationRules>
                                <validation:PhoneNumberValidationRule/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>

                <TextBlock Grid.Row="3"
                           Text="Email:" 
                           Margin="3">
                </TextBlock>

                <TextBox Grid.Row="4" 
                         Style="{StaticResource TextBoxStyle}">
                    <TextBox.Text>
                        <Binding Path ="CurrentContact.Email" 
                                 UpdateSourceTrigger="PropertyChanged" 
                                 Mode="TwoWay">
                            <Binding.ValidationRules>
                                <validation:EmailValidationRule/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>

                <Button Grid.Row="5" Content="Apply" 
                        Command="{Binding ApplyContactCommand}"
                        Style="{StaticResource IsApplyButton}"
                        HorizontalAlignment="Left"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
